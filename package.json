{
  "name": "@sorocrew/provider",
  "version": "0.1.0",
  "description": "Injected window.stellar & Freighter-compatible wallet provider SDK for Soroban dApp testing",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorocrew/provider.git"
  },
  "homepage": "https://github.com/sorocrew/provider#readme",
  "bugs": {
    "url": "https://github.com/sorocrew/provider/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "freighter",
    "provider",
    "wallet",
    "web3",
    "dapp"
  ],
  "author": "SoroCrew",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
